  (global_label "VSENSE" (shape passive) (at 668.02 368.3 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1ce3adac-d58a-4753-aae3-8a92f153064c") (property "Intersheet References" "${INTERSHEET_REFS}" (at 668.02 368.3 0) (effects (font (size 1.27 1.27)) (justify left) hide)))
  (text "Power: 5 V, PS_ON and PWR_OK from the 24-pin ATX header J2 (its 12 V pins 10, 11 are not connected). 12 V from the 4-pin ATX12V CPU lead on J3 (pins 3, 4; COM pins 1, 2 not connected, the return is J2's eight GND pins) -> 7.5 A fuse -> +12V_IN -> K1 -> +12V_MOT (1.5KE16A clamp, 4 x 1000 uF)." (at 130 432 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "a6c0d16b-062d-4d4b-a5c5-46f02032393c"))
  (text "5 V: the five 5 V pins (4, 6, 21-23) through F3 (3 A) are the logic rail +5V (encoder LEDs through 47 R, the DevKit through D21, the pixels through the D22 link). 3.3 V, -12 V, 5VSB unused. The Pi is not powered here." (at 130 436 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6245bf3f-4ec2-40b2-866a-d592621fce00"))
  (text "PS_ON must be at ground for the supply to run: JP1 fitted = on (or a panel switch on its pins). PWR_OK only on TP12." (at 130 440 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9b40f8bf-40f5-4025-8a8f-d9b96ed21313"))
